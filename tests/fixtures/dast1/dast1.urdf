  </joint>
  <gazebo reference="kinect_link">
    <sensor name="kinect" type="rgbd_camera">
      <camera>
        <horizontal_fov>1.0542</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
